{
  "name": "caseflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w server",
    "eval": "npm run eval -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
